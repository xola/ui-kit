{
    "name": "@xola/ui-kit",
    "version": "2.4.0",
    "description": "Xola UI Kit",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/xola/ui-kit.git"
    },
    "files": [
        "build",
        "index.css",
        "index.d.ts",
        "tailwind.config.js",
        "postcss.config.js"
    ],
    "main": "build/ui-kit.umd.js",
    "module": "build/ui-kit.mjs",
    "types": "index.d.ts",
    "scripts": {
        "prepare": "node scripts/prepare && vite build",
        "start": "npm run storybook",
        "dev": "npm run clean && npm run prepare && storybook dev -p 6006 --no-open",
        "storybook": "npm run prepare && storybook dev -p 6006 --no-open",
        "build": "npm run prepare && vite build",
        "clean": "rm -rf node_modules/.vite node_modules/.cache",
        "build:storybook": "npm run prepare && storybook build",
        "lint": "eslint --cache --cache-strategy content --ext .js,.jsx --fix src",
        "lint:report": "eslint --cache --cache-strategy content --ext .js,.jsx --output-file=eslint_report.json --format=json src",
        "format": "prettier -l --write src",
        "test": "jest"
    },
    "dependencies": {
        "@headlessui/react": "^1.4.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/line-clamp": "^0.3.1",
        "@tippyjs/react": "^4.2.6",
        "ahooks": "^3.9.7",
        "axios": "^1.19.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "downshift": "^6.1.5",
        "get-user-locale": "^1.4.0",
        "libphonenumber-js": "^1.13.11",
        "nouislider-react": "^3.4.2",
        "prop-types": "^15.7.2",
        "react-day-picker": "^7.4.10",
        "react-hot-toast": "^2.6.0",
        "react-hotkeys-hook": "^3.4.0",
        "react-select": "^5.7.0",
        "react-textarea-autosize": "^8.5.9",
        "tippy.js": "^6.3.7",
        "use-debounce": "^10.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.14.8",
        "@babel/preset-env": "^7.15.6",
        "@babel/preset-react": "^7.29.7",
        "@storybook/addon-actions": "^7.6.24",
        "@storybook/addon-designs": "^7.0.9",
        "@storybook/addon-essentials": "^7.6.24",
        "@storybook/addon-links": "^7.6.24",
        "@storybook/blocks": "^7.6.24",
        "@storybook/manager-api": "^7.6.24",
        "@storybook/react": "^7.6.24",
        "@storybook/react-vite": "^7.6.24",
        "@storybook/theming": "^7.6.24",
        "autoprefixer": "^10.4.5",
        "babel-jest": "^29.7.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-config-xo": "^0.41.0",
        "eslint-config-xo-react": "^0.27.0",
        "eslint-formatter-pretty": "^4.1.0",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-n": "^15.2.2",
        "eslint-plugin-no-use-extend-native": "^0.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "eslint-plugin-react": "^7.30.0",
        "eslint-plugin-react-hooks": "^4.5.0",
        "eslint-plugin-unicorn": "^42.0.0",
        "jest": "^29.7.0",
        "lodash": "^4.18.1",
        "postcss": "^8.4.5",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-json-view": "^1.21.3",
        "storybook": "^7.6.24",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^4.5.14",
        "zx": "^8.8.5"
    },
    "overrides": {
        "body-parser": "^1.20.3",
        "braces": "^3.0.3",
        "micromatch": "^4.0.8",
        "node-releases": "2.0.44",
        "flow-parser": "0.318.0",
        "postcss-load-config": "^4.0.2"
    },
    "peerDependencies": {
        "autoprefixer": "^10.3.1",
        "lodash": "^4.17.21",
        "postcss": "^8.3.6",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "tailwindcss": "^3.0.18"
    },
    "engines": {
        "node": ">=16"
    },
    "prettier": {
        "semi": true,
        "printWidth": 120,
        "trailingComma": "all",
        "singleQuote": false,
        "bracketSpacing": true,
        "useTabs": false,
        "arrowParens": "always",
        "bracketSameLine": false,
        "tabWidth": 4
    }
}
